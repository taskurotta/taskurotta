# Шаблон env для E2E-стека (плейбук e2e-load-test). Скопировать в .env рядом с
# compose-файлами и заполнить локальными e2e-учётками (рецепт — playbook.md,
# раздел «env: как заполнить»). В git попасть могут только плейсхолдеры.

# Конфиг taskurotta: имя файла в каталоге server/ боевого деплоя
TASKUROTTA_CONFIG=hz-postgres.yml
# Абсолютные пути к локальным копиям конфигов боевого деплоя
# (см. playbook.md, «Процедура обновления конфигурации»)
TASKUROTTA_CONFIG_DIR=/abs/path/to/local-copies/server
TASKUROTTA_SCHEDULER_DIR=/abs/path/to/local-copies/scheduler
# Каталог логов стека (создать до старта: taskurotta/ и postgres/ подкаталоги)
E2E_LOG_DIR=/abs/path/to/e2e-logs

# БД: taskurotta подключается через pgbouncer под пользователем postgres
# (bitnami-образ pgbouncer строит свой userlist из env — см. userlists.txt)
TASKUROTTA_DB_URL=jdbc:postgresql://e2e-pgbouncer:6432/taskurotta
TASKUROTTA_DB_USER=postgres
TASKUROTTA_DB_PASS=REPLACE_WITH_LOCAL_E2E_PASSWORD

# postgres-контейнер: имя суперпользователя, создаваемого контейнером;
# пароль — тот же локальный e2e, что и в двух строках ниже
APP_DB_USERNAME=REPLACE_WITH_LOCAL_E2E_DB_USER
APP_DB_PASSWORD=REPLACE_WITH_LOCAL_E2E_PASSWORD

# pgbouncer -> postgres
PGBOUNCER_POSTGRES_HOST=e2e-top-db16
PGBOUNCER_POSTGRES_PORT=5432
PGBOUNCER_POSTGRES_PASS=REPLACE_WITH_LOCAL_E2E_PASSWORD
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_POOL_SIZE=30
PGBOUNCER_POOL_MIN=5
# >0 обязательно: при 0 в transaction-пуллинге теряются prepared statements
# (500 «prepared statement does not exist» на POST /rest/tasks/start)
PGBOUNCER_MAX_PREPARED_STATEMENTS=128
